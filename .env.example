PORT=3000
NODE_ENV=production
DATABASE_PATH=./data/bracketcanvas.sqlite
PUBLIC_APP_URL=https://bracketcanvas.jesuiskoriel.dev

# Mail de reset mot de passe.
MAIL_FROM="BracketCanvas <no-reply@bracketcanvas.jesuiskoriel.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Origines additionnelles autorisees, separees par des virgules.
ALLOWED_ORIGINS=
# Adresses autorisees avec un lancement direct de Node.
ADMIN_EMAILS=
# Adresses autorisees avec Docker Compose.
BRACKETCANVAS_ADMIN_EMAILS=
